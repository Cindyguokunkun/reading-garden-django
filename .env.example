# 复制为 .env 后填写。.env 已被 gitignore，切勿提交或把密钥贴进聊天/issue。
# 真实环境变量优先于本文件。

# --- AR BookFinder 抓取（查 ATOS / 词数 / 内容简介）---
# 本机 Clash 代理；留空则直连（直连约 8 秒，走代理约 2 秒）
ARF_PROXY=http://127.0.0.1:7897
ARF_TIMEOUT=15
# 两次请求之间的最小间隔（秒），礼貌抓取
ARF_THROTTLE=1.0

# --- AI 出题（任何 OpenAI 兼容的 /chat/completions 端点）---
# 三项都填了才会启用出题按钮；国内端点一般无需代理，QUIZGEN_PROXY 留空即可
QUIZGEN_BASE_URL=
QUIZGEN_API_KEY=
QUIZGEN_MODEL=
QUIZGEN_PROXY=
# 生成 10 题约 40-80 秒；超时后返回错误而不是卡死
QUIZGEN_TIMEOUT=120
QUIZGEN_QUESTIONS=10
# 有效题目少于此数就判定本次生成失败
QUIZGEN_MIN_QUESTIONS=5
# 喂给模型的素材字数上限（上传的 .txt 会截断到这个长度）
QUIZGEN_MATERIAL_CHARS=8000
# 端点不支持 response_format=json_object 时改成 0
QUIZGEN_JSON_MODE=1
